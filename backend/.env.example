# Expense Tracker Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=devops-automated-expense-tracker-jwt-secret-key-32chars
JWT_EXPIRES_IN=7d
DB_PATH=./data/expense_tracker.sqlite
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
MAX_FILE_SIZE_MB=5
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
