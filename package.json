{
  "name": "automated-expense-tracker",
  "version": "1.0.0",
  "description": "Production-grade Automated Expense Tracker application for DevOps engineering",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=backend & npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "seed": "npm run seed --workspace=backend",
    "lint": "echo \"Linting backend and frontend...\""
  },
  "keywords": [
    "expense-tracker",
    "devops",
    "docker",
    "kubernetes",
    "sqlite",
    "react",
    "nodejs",
    "express"
  ],
  "author": "jvssiddhartha",
  "license": "MIT"
}
